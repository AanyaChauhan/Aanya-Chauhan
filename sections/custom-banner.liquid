{%- comment -%}
  Custom Banner Section
  - Top bar: logo / center text / button
  - Middle: hero banner (bottom positioned) + row (30% content / 70% repeated banner)
  - Bottom bar: centered rich text
{%- endcomment -%}

{% capture btn_icon %}
<svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M0.75 4.77295L7.37629e-08 4.77295L-7.37629e-08 6.27295L0.75 6.27295L0.75 4.77295ZM25.2803 6.05328C25.5732 5.76039 25.5732 5.28551 25.2803 4.99262L20.5074 0.21965C20.2145 -0.0732435 19.7396 -0.0732436 19.4467 0.21965C19.1538 0.512543 19.1538 0.987417 19.4467 1.28031L23.6893 5.52295L19.4467 9.76559C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1191 20.2145 11.1191 20.5074 10.8263L25.2803 6.05328ZM0.75 6.27295L24.75 6.27295L24.75 4.77295L0.75 4.77295L0.75 6.27295Z" fill="currentColor"/>
</svg>
{% endcapture %}


{%- style -%}
  .custom-banner-section {
    --top-bg: {{ section.settings.top_bg }};
    --top-text-color: {{ section.settings.top_text_color }};
    --top-text-size-d: {{ section.settings.top_text_size_desktop }}px;
    --top-text-size-m: {{ section.settings.top_text_size_mobile }}px;

    --top-btn-size-d: {{ section.settings.top_btn_size_desktop }}px;
    --top-btn-size-m: {{ section.settings.top_btn_size_mobile }}px;
    --top-btn-color: {{ section.settings.top_btn_text_color }};
    --top-btn-bg: {{ section.settings.top_btn_bg }};
    --top-btn-color-hover: {{ section.settings.top_btn_text_color_hover }};
    --top-btn-bg-hover: {{ section.settings.top_btn_bg_hover }};

    --heading-color: {{ section.settings.heading_color }};
    --heading-size-d: {{ section.settings.heading_size_desktop }}px;
    --heading-size-m: {{ section.settings.heading_size_mobile }}px;

    --desc-color: {{ section.settings.description_color }};
    --desc-size-d: {{ section.settings.description_size_desktop }}px;
    --desc-size-m: {{ section.settings.description_size_mobile }}px;

    --mid-btn-size-d: {{ section.settings.middle_btn_size_desktop }}px;
    --mid-btn-size-m: {{ section.settings.middle_btn_size_mobile }}px;
    --mid-btn-color: {{ section.settings.middle_btn_text_color }};
    --mid-btn-bg: {{ section.settings.middle_btn_bg }};
    --mid-btn-color-hover: {{ section.settings.middle_btn_text_color_hover }};
    --mid-btn-bg-hover: {{ section.settings.middle_btn_bg_hover }};

    --bottom-bg: {{ section.settings.bottom_bg }};
    --bottom-text-color: {{ section.settings.bottom_text_color }};
    --bottom-text-size-d: {{ section.settings.bottom_text_size_desktop }}px;
    --bottom-text-size-m: {{ section.settings.bottom_text_size_mobile }}px;

    overflow: hidden;
  }

  .custom-banner-section * { box-sizing: border-box; }

  /* ---------- TOP BAR ---------- */
  .custom-banner-section .cb-top {
    background-color: var(--top-bg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 50px;
    flex-wrap: wrap;
  }
  .custom-banner-section .cb-top__logo { flex: 0 0 auto; display: flex; align-items: center; }
  .custom-banner-section .cb-top__logo img { max-height: 32px; width: auto; display: block; }
  .custom-banner-section .cb-top__logo-text {
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--top-text-color);
  }
  .custom-banner-section .cb-top__text {
    font-weight: 400;
    line-height: 1.3;
    flex: 1 1 auto;
    text-align: center;
    color: var(--top-text-color);
    font-size: var(--top-text-size-m);
    min-width: 140px;
  }
  .custom-banner-section .cb-top__btn { flex: 0 0 auto; }

  /* ---------- BUTTONS (shared wipe hover) ---------- */
  .custom-banner-section .cb-btn {
    display: inline-flex;
    align-items: center;
    text-transform: uppercase;
    gap: 10px;
    text-decoration: none;
    white-space: nowrap;
    padding: 12px 20px 12px 40px;
    transition: color 0.35s cubic-bezier(.4, 0, .2, 1), background 0.35s cubic-bezier(.4, 0, .2, 1);
    background-size: 200% 100%;
    background-position: right bottom;
  }
  .custom-banner-section .cb-btn__icon { display: inline-flex; line-height: 0; }
  .custom-banner-section .cb-btn__icon svg { display: block; height: 12px; width: auto; }

  .custom-banner-section .cb-btn--top {
    font-size: var(--top-btn-size-m);
    color: var(--top-btn-color);
    background-image: linear-gradient(90deg, var(--top-btn-bg-hover) 50%, var(--top-btn-bg) 50%);
  }
  .custom-banner-section .cb-btn--top:hover {
    color: var(--top-btn-color-hover);
    background-position: left bottom;
  }

  .custom-banner-section .cb-btn--middle {
    font-size: var(--mid-btn-size-m);
    color: var(--mid-btn-color);
    background-image: linear-gradient(90deg, var(--mid-btn-bg-hover) 50%, var(--mid-btn-bg) 50%);
  }
  .custom-banner-section .cb-btn--middle:hover {
    color: var(--mid-btn-color-hover);
    background-position: left bottom;
  }

  /* ---------- MIDDLE ---------- */
  .custom-banner-section .cb-middle__hero {
    width: 100%;
    aspect-ratio: 16 / 5;
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: cover;
  }

  .custom-banner-section .cb-middle__row {
    display: flex;
    align-items: stretch;
    width: 100%;
  }

  .custom-banner-section .cb-middle__content {
    width: 40%;
    flex: 0 0 40%;
    padding: 66px 0 66px 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    min-width: 0;
  }
  .custom-banner-section .cb-middle__heading {
    margin: 0;
    color: var(--heading-color);
    font-size: var(--heading-size-m);
    line-height: 1.1;
  }
  .custom-banner-section .cb-middle__desc {
    color: var(--desc-color);
    font-size: var(--desc-size-m);
    line-height: 1.5;
  }
  .custom-banner-section .cb-middle__desc p { margin: 0 0 8px; }
  .custom-banner-section .cb-middle__desc p:last-child { margin-bottom: 0; }
  .custom-banner-section .cb-middle__content .cb-btn { align-self: flex-start; }

  .custom-banner-section .cb-middle__repeat {
    width: 60%;
    flex: 0 0 60%;
    width: 100%;
    background-repeat: no-repeat;
    background-position: top left;
    background-size: auto 120%;
  }

  /* ---------- BOTTOM BAR ---------- */
  .custom-banner-section .cb-bottom {
    background-color: var(--bottom-bg);
    padding: 14px 24px;
    text-align: center;
  }
  .custom-banner-section .cb-bottom__text {
    color: var(--bottom-text-color);
    font-size: var(--bottom-text-size-m);
    line-height: 1.4;
  }
  .custom-banner-section .cb-bottom__text p { margin: 0; }

  /* ---------- DESKTOP ---------- */
    @media screen and (min-width: 750px) {
    .custom-banner-section .cb-top__text { font-size: var(--top-text-size-d); }
    .custom-banner-section .cb-btn--top { font-size: var(--top-btn-size-d); }
    .custom-banner-section .cb-btn--middle { font-size: var(--mid-btn-size-d); }
    .custom-banner-section .cb-middle__heading { font-size: var(--heading-size-d); }
    .custom-banner-section .cb-middle__desc { font-size: var(--desc-size-d); }
    .custom-banner-section .cb-bottom__text { font-size: var(--bottom-text-size-d); }
    .custom-banner-section .cb-middle__row { aspect-ratio: 16 / 5; }
  }

  /* ---------- MOBILE STACK ---------- */
  @media screen and (max-width: 749px) {
    .custom-banner-section .cb-top { padding: 12px 16px; justify-content: center; text-align: center; }
    .custom-banner-section .cb-top__text { order: 3; flex-basis: 100%; }
    .custom-banner-section .cb-middle__row { flex-direction: column; }
    .custom-banner-section .cb-middle__content,
    .custom-banner-section .cb-middle__repeat {
      width: 100%;
      flex-basis: auto;
    }
    .custom-banner-section .cb-middle__content { padding: 28px 20px; text-align: center; align-items: center; }
    .custom-banner-section .cb-middle__content .cb-btn { align-self: center; }
    .custom-banner-section .cb-middle__repeat { aspect-ratio: 16 / 7; }
    .custom-banner-section .cb-middle__hero { aspect-ratio: 16 / 8; }
    .custom-banner-section .cb-bottom { padding: 12px 16px; }
  }
{%- endstyle -%}

<div class="custom-banner-section">
  <div class="cb-top">
    <div class="cb-top__logo">
      {%- if section.settings.logo -%}
        <img
          src="{{ section.settings.logo | image_url: width: 300 }}"
          alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          loading="lazy"
        >
      {%- else -%}
        <span class="cb-top__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </div>

    {%- if section.settings.top_text != blank -%}
      <div class="cb-top__text">{{ section.settings.top_text }}</div>
    {%- endif -%}

    <div class="cb-top__btn">
      {%- if section.settings.top_btn_text != blank -%}
        <a href="{{ section.settings.top_btn_link | default: '#' }}" class="cb-btn cb-btn--top">
          <span>{{ section.settings.top_btn_text }}</span>
          <span class="cb-btn__icon">{{ btn_icon }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="cb-middle">
    {%- if section.settings.banner_image -%}
      <div
        class="cb-middle__hero"
        style="background-image: url('{{ section.settings.banner_image | image_url: width: 1600 }}');"
      ></div>
    {%- endif -%}

    <div class="cb-middle__row">
      <div class="cb-middle__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="cb-middle__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="cb-middle__desc">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if section.settings.middle_btn_text != blank -%}
          <a href="{{ section.settings.middle_btn_link | default: '#' }}" class="cb-btn cb-btn--middle">
            <span>{{ section.settings.middle_btn_text }}</span>
            <span class="cb-btn__icon">{{ btn_icon }}</span>
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.banner_image -%}
        <div
          class="cb-middle__repeat"
          style="background-image: url('{{ section.settings.banner_image | image_url: width: 1000 }}');"
        ></div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.bottom_text != blank -%}
    <div class="cb-bottom">
      <div class="cb-bottom__text">{{ section.settings.bottom_text }}</div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    { "type": "header", "content": "Top bar" },
    { "type": "color", "id": "top_bg", "label": "Background color", "default": "#F5F4F2" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "top_text", "label": "Center text", "default": "Find the ideal gift for your loved ones." },
    { "type": "color", "id": "top_text_color", "label": "Text color", "default": "#1A1A1A" },
    {
      "type": "range",
      "id": "top_text_size_desktop",
      "label": "Text size (desktop)",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "top_text_size_mobile",
      "label": "Text size (mobile)",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },

    { "type": "header", "content": "Top bar button" },
    { "type": "text", "id": "top_btn_text", "label": "Button text", "default": "Choose gift" },
    { "type": "url", "id": "top_btn_link", "label": "Button link" },
    {
      "type": "range",
      "id": "top_btn_size_desktop",
      "label": "Button text size (desktop)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "top_btn_size_mobile",
      "label": "Button text size (mobile)",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    { "type": "color", "id": "top_btn_text_color", "label": "Text color", "default": "#1A1A1A" },
    { "type": "color", "id": "top_btn_bg", "label": "Background color", "default": "#F5E400" },
    { "type": "color", "id": "top_btn_text_color_hover", "label": "Text color (hover)", "default": "#FFFFFF" },
    { "type": "color", "id": "top_btn_bg_hover", "label": "Background color (hover)", "default": "#1A1A1A" },

    { "type": "header", "content": "Middle section" },
    { "type": "image_picker", "id": "banner_image", "label": "Banner image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1A1A1A" },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 20,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    { "type": "color", "id": "description_color", "label": "Description color", "default": "#4A4A4A" },
    {
      "type": "range",
      "id": "description_size_desktop",
      "label": "Description size (desktop)",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "label": "Description size (mobile)",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 13
    },

    { "type": "header", "content": "Middle section button" },
    { "type": "text", "id": "middle_btn_text", "label": "Button text", "default": "Shop now" },
    { "type": "url", "id": "middle_btn_link", "label": "Button link" },
    {
      "type": "range",
      "id": "middle_btn_size_desktop",
      "label": "Button text size (desktop)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "middle_btn_size_mobile",
      "label": "Button text size (mobile)",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    { "type": "color", "id": "middle_btn_text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "color", "id": "middle_btn_bg", "label": "Background color", "default": "#1A1A1A" },
    { "type": "color", "id": "middle_btn_text_color_hover", "label": "Text color (hover)", "default": "#1A1A1A" },
    { "type": "color", "id": "middle_btn_bg_hover", "label": "Background color (hover)", "default": "#F5E400" },

    { "type": "header", "content": "Bottom bar" },
    { "type": "color", "id": "bottom_bg", "label": "Background color", "default": "#1A1A1A" },
    {
      "type": "richtext",
      "id": "bottom_text",
      "label": "Text",
      "default": "<p>Sustainable, ethically made clothes in sizes XXS to 6XL</p>"
    },
    { "type": "color", "id": "bottom_text_color", "label": "Text color", "default": "#FFFFFF" },
