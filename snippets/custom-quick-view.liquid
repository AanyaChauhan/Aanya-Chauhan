{% liquid
  assign variant = product.selected_or_first_available_variant

  # Find which option index is "Color" and which is "Size" so this works
  # regardless of the order options were set up in on each product.
  assign color_option_index = -1
  assign size_option_index = -1

  for option in product.options_with_values
    assign downcased_name = option.name | downcase
    if downcased_name == 'color' or downcased_name == 'colour'
      assign color_option_index = forloop.index0
    endif
    if downcased_name == 'size'
      assign size_option_index = forloop.index0
    endif
  endfor
%}

<div
  class="ec-quick-view"
  id="QuickView-{{ product.id }}"
  data-quick-view
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-cross-sell-variant-id="{{ cross_sell_variant_id }}"
  hidden
>
  <div class="ec-quick-view__panel" role="dialog" aria-modal="true" aria-labelledby="QuickViewTitle-{{ product.id }}">

    <button
      type="button"
      class="ec-quick-view__close"
      data-quick-view-close
      aria-label="Close quick view"
    >
      <span aria-hidden="true">&times;</span>
    </button>

        <div class="ec-quick-view__content">
      <div class="ec-quick-view__top">
        <div class="ec-quick-view__media">
          <img
            class="ec-quick-view__image"
            data-quick-view-image
            src="{{ product.featured_image | image_url: width: 600 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            width="600"
            height="{{ 600 | divided_by: product.featured_image.aspect_ratio | default: 600 }}"
            loading="lazy"
          >
        </div>

        <div class="ec-quick-view__info">
          <h3 id="QuickViewTitle-{{ product.id }}" class="ec-quick-view__title">
            {{ product.title }}
          </h3>

          <p class="ec-quick-view__price" data-quick-view-price>
            {{ variant.price | money }}
          </p>

          {% if product.description != blank %}
            <div class="ec-quick-view__description">
              {{ product.description }}
            </div>
          {% endif %}
        </div>
      </div>

      {% comment %}
        Full product/variant data as JSON so product-grid.js can resolve the
        matching variant on option change without an extra network request.
      {% endcomment %}
      <script type="application/json" data-quick-view-json>
        {{ product | json }}
      </script>

      <form data-quick-view-form data-product-id="{{ product.id }}">

        {% if color_option_index > -1 %}
          {% assign color_option = product.options_with_values[color_option_index] %}
          <fieldset class="ec-quick-view__option" data-option-index="{{ color_option_index }}">
            <legend class="ec-quick-view__option-label">{{ color_option.name }}</legend>

            <div class="ec-quick-view__color-bars">
              {% for value in color_option.values %}
                <label class="ec-quick-view__color-bar">
                  <input
                    type="radio"
                    class="ec-quick-view__color-bar-input"
                    name="option-{{ color_option_index }}-{{ product.id }}"
                    value="{{ value | escape }}"
                    data-option-input
                    data-option-index="{{ color_option_index }}"
                  >
                  <span class="ec-quick-view__color-bar-visual" data-color="{{ value | handle }}"></span>
                  <span class="ec-quick-view__color-bar-name">{{ value }}</span>
                </label>
              {% endfor %}
            </div>
          </fieldset>
        {% endif %}

                {% if size_option_index > -1 %}
          {% assign size_option = product.options_with_values[size_option_index] %}
          <div class="ec-quick-view__option">
            <label class="ec-quick-view__option-label" id="SizeLabel-{{ product.id }}">
              {{ size_option.name }}
            </label>
            <div class="ec-quick-view__select-wrapper" data-size-dropdown>
              <button
                type="button"
                class="ec-quick-view__select-trigger"
                data-size-trigger
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-labelledby="SizeLabel-{{ product.id }}"
              >
                <span data-size-trigger-text>Choose your size</span>
                <span class="ec-quick-view__select-arrow" aria-hidden="true">&#9662;</span>
              </button>
              <ul class="ec-quick-view__select-list" data-size-list role="listbox" hidden>
                {% for value in size_option.values %}
                  <li
                    class="ec-quick-view__select-option"
                    role="option"
                    data-value="{{ value | escape }}"
                    aria-selected="false"
                  >{{ value }}</li>
                {% endfor %}
              </ul>
              <input
                type="hidden"
                data-option-input
                data-option-index="{{ size_option_index }}"
                value=""
              >
            </div>
          </div>
        {% endif %}

        {% comment %} Kept in sync by JS as the shopper picks options. {% endcomment %}
                <input type="hidden" name="id" value="" data-selected-variant-id>

        <div class="ec-quick-view__status" role="status" aria-live="polite" data-quick-view-status></div>

                <button
          type="submit"
          class="ec-quick-view__submit"
          data-quick-view-submit
          {% unless variant.available %}disabled{% endunless %}
        >
          <span data-quick-view-submit-text>
            {% if variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
          </span>
          <span class="ec-quick-view__submit-arrow" aria-hidden="true">&rarr;</span>
        </button>
      </form>
    </div>
  </div>
</div>

<style>
  /* Scoped with an .ec- prefix so nothing bleeds in from/to Dawn's base CSS. */

  .ec-quick-view {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.5);
    padding: 1.5rem;
  }

  .ec-quick-view[hidden] {
    display: none;
  }

    .ec-quick-view__panel {
    position: relative;
    display: block;
    width: 100%;
    max-width: 640px;
    max-height: 90vh;
    overflow-y: auto;
    background: #fff;
  }

  .ec-quick-view__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 2rem;
    height: 2rem;
    border: none;
    background: transparent;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

   .ec-quick-view__content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .ec-quick-view__top {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .ec-quick-view__media {
    flex: 0 0 96px;
    width: 96px;
    height: 96px;
  }

  .ec-quick-view__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ec-quick-view__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ec-quick-view__title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 500;
  }

  .ec-quick-view__price {
    margin: 0;
    font-size: 1.125rem;
  }

  .ec-quick-view__description {
    font-size: 0.875rem;
    color: #555;
  }

  .ec-quick-view__option {
    margin: 0;
    padding: 0;
    border: none;
  }

  .ec-quick-view__option-label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Color bars: horizontal strip, each value gets equal width, divided by a border. */
  .ec-quick-view__color-bars {
    display: flex;
    border: 1px solid #000;
  }

    .ec-quick-view__color-bar {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem 0.75rem 1.75rem;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ec-quick-view__color-bar,
    .ec-quick-view__color-bar-name {
      transition-property: background-color, color;
      transition-duration: var(--animation-speed, 0.2s);
      transition-timing-function: var(--ease-out-cubic, ease);
    }
  }

  .ec-quick-view__color-bar:not(:last-child) {
    border-right: 1px solid #000;
  }

  .ec-quick-view__color-bar-input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

    .ec-quick-view__color-bar-visual {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 6px;
    background: var(--ec-bar-color, #ccc);
  }

  /* Swap these for real hex codes to match your color option values. */
  .ec-quick-view__color-bar-visual[data-color="black"] { --ec-bar-color: #000; }
  .ec-quick-view__color-bar-visual[data-color="white"] { --ec-bar-color: #fff; border: 1px solid #ccc; }
  .ec-quick-view__color-bar-visual[data-color="grey"],
  .ec-quick-view__color-bar-visual[data-color="gray"] { --ec-bar-color: #888; }
  .ec-quick-view__color-bar-visual[data-color="red"] { --ec-bar-color: #b0203e; }
  .ec-quick-view__color-bar-visual[data-color="blue"] { --ec-bar-color: #1b3a6b; }

    .ec-quick-view__color-bar.is-selected {
    background: #000;
  }

  .ec-quick-view__color-bar.is-selected .ec-quick-view__color-bar-name {
    color: #fff;
  }

  .ec-quick-view__color-bar-input:focus-visible ~ .ec-quick-view__color-bar-visual {
    outline: 2px dashed #000;
    outline-offset: 2px;
  }

  .ec-quick-view__color-bar-name {
    font-size: 0.8125rem;
  }

    .ec-quick-view__select-wrapper {
    position: relative;
    border: 1px solid #000;
  }

  .ec-quick-view__select-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.75rem 1rem;
    border: none;
    background: transparent;
    font-size: 0.875rem;
    text-align: left;
    cursor: pointer;
    appearance: none;
  }

  .ec-quick-view__select-arrow {
    font-size: 0.7rem;
  }

  .ec-quick-view__select-list {
    position: absolute;
    top: calc(100% + 2px);
    left: 0;
    right: 0;
    z-index: 5;
    margin: 0;
    padding: 0;
    list-style: none;
    max-height: 12rem;
    overflow-y: auto;
    background: #fff;
    border: 1px solid #000;
  }

  .ec-quick-view__select-option {
    padding: 0.65rem 1rem;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .ec-quick-view__select-option:hover,
  .ec-quick-view__select-option[aria-selected="true"] {
    background: #000;
    color: #fff;
  }

  .ec-quick-view__status {
    min-height: 1rem;
    font-size: 0.8125rem;
  }

  .ec-quick-view__status[data-status="error"] {
    color: #b0203e;
  }

    .ec-quick-view__submit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: auto;
    padding: 1rem 1.25rem;
    border: none;
    color: #fff;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    background-image: linear-gradient(90deg, #FFF544 50%, #000 50%);
    background-size: 200% 100%;
    background-position: right bottom;
    transition: color 0.35s cubic-bezier(.4,0,.2,1), background-position 0.35s cubic-bezier(.4,0,.2,1);
  }

  .ec-quick-view__submit:not(:disabled):hover {
    color: #000;
    background-position: left bottom;
  }

  .ec-quick-view__submit:disabled {
    background: #999;
    background-image: none;
    cursor: not-allowed;
  }

  .ec-quick-view__submit-arrow {
    transition: transform 0.15s ease;
  }

  .ec-quick-view__submit:not(:disabled):hover .ec-quick-view__submit-arrow {
    transform: translateX(4px);
  }

    @media screen and (max-width: 749px) {
    .ec-quick-view__panel {
      max-height: 95vh;
    }

    .ec-quick-view__content {
      padding: 1.25rem;
    }
  }
</style>

<script>
  /*
   * Runs once per page even though this snippet renders once per hotspot
   * product. The guard below stops duplicate listeners from stacking up.
   */
  if (!window.__ecQuickViewInit) {
    window.__ecQuickViewInit = true;

    document.addEventListener('DOMContentLoaded', initQuickViews);
    if (document.readyState !== 'loading') initQuickViews();

        function initQuickViews() {
      var panels = document.querySelectorAll('[data-quick-view]');

      // Grid hotspots dispatch this event to open a specific product's panel:
      // document.dispatchEvent(new CustomEvent('ec:open-quick-view', { detail: { productId } }))
      document.addEventListener('ec:open-quick-view', function (event) {
        var id = event.detail && event.detail.productId;
        var panel = document.querySelector('[data-quick-view][data-product-id="' + id + '"]');
        if (panel) openPanel(panel);
      });

      document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;
        var open = document.querySelector('[data-quick-view]:not([hidden])');
        if (open) closePanel(open);
      });

      panels.forEach(function (panel) {
        try {
          setUpPanel(panel);
        } catch (err) {
          console.error('Quick view setup failed for panel', panel.id, err);
        }
      });
    }

    function setUpPanel(panel) {
      var jsonEl = panel.querySelector('[data-quick-view-json]');
      var product = JSON.parse(jsonEl.textContent);

      var form = panel.querySelector('[data-quick-view-form]');
      var priceEl = panel.querySelector('[data-quick-view-price]');
      var idInput = panel.querySelector('[data-selected-variant-id]');
      var submitBtn = panel.querySelector('[data-quick-view-submit]');
      var submitText = panel.querySelector('[data-quick-view-submit-text]');
      var statusEl = panel.querySelector('[data-quick-view-status]');
      var imageEl = panel.querySelector('[data-quick-view-image]');
      var closeBtn = panel.querySelector('[data-quick-view-close]');
      var optionInputs = panel.querySelectorAll('[data-option-input]');

      closeBtn.addEventListener('click', function () {
        closePanel(panel);
      });

      panel.addEventListener('click', function (event) {
        if (event.target === panel) closePanel(panel);
      });

      optionInputs.forEach(function (input) {
        input.addEventListener('change', handleOptionChange);
      });

            function handleOptionChange() {
        panel.querySelectorAll('.ec-quick-view__color-bar').forEach(function (bar) {
          var input = bar.querySelector('.ec-quick-view__color-bar-input');
          bar.classList.toggle('is-selected', !!(input && input.checked));
        });

        var selected = getSelectedOptions();
        var variant = findVariant(product, selected);
        updateForVariant(variant, selected);
      }

      var sizeDropdown = panel.querySelector('[data-size-dropdown]');
      if (sizeDropdown) {
        var sizeTrigger = sizeDropdown.querySelector('[data-size-trigger]');
        var sizeTriggerText = sizeDropdown.querySelector('[data-size-trigger-text]');
        var sizeList = sizeDropdown.querySelector('[data-size-list]');
        var sizeHiddenInput = sizeDropdown.querySelector('input[type="hidden"][data-option-input]');
        var sizeOptions = sizeDropdown.querySelectorAll('.ec-quick-view__select-option');

        sizeTrigger.addEventListener('click', function (event) {
          event.stopPropagation();
          var isOpen = !sizeList.hidden;
          sizeList.hidden = isOpen;
          sizeTrigger.setAttribute('aria-expanded', String(!isOpen));
        });

        sizeOptions.forEach(function (option) {
          option.addEventListener('click', function () {
            sizeOptions.forEach(function (opt) { opt.setAttribute('aria-selected', 'false'); });
            option.setAttribute('aria-selected', 'true');
            sizeTriggerText.textContent = option.getAttribute('data-value');
            sizeHiddenInput.value = option.getAttribute('data-value');
            sizeHiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
            sizeList.hidden = true;
            sizeTrigger.setAttribute('aria-expanded', 'false');
          });
        });

        document.addEventListener('click', function (event) {
          if (!sizeDropdown.contains(event.target)) {
            sizeList.hidden = true;
            sizeTrigger.setAttribute('aria-expanded', 'false');
          }
        });
      }

      handleOptionChange();

      function getSelectedOptions() {
        // Build an ordered array of the currently chosen value per option index.
        var byIndex = {};

        panel.querySelectorAll('[data-option-input]').forEach(function (input) {
          var index = input.getAttribute('data-option-index');
          if (input.type === 'radio') {
            if (input.checked) byIndex[index] = input.value;
          } else {
            if (input.value) byIndex[index] = input.value;
          }
        });

        var maxIndex = product.options.length - 1;
        var ordered = [];
        for (var i = 0; i <= maxIndex; i++) {
          ordered.push(byIndex[i] || null);
        }
        return ordered;
      }

      function findVariant(product, selected) {
        return product.variants.find(function (variant) {
          return selected.every(function (value, index) {
            return value === null || variant.options[index] === value;
          });
        });
      }

            function updateForVariant(variant, selected) {
        var allChosen = selected.every(function (value) { return value !== null; });

        if (allChosen && variant) {
          priceEl.textContent = formatMoney(variant.price);
          idInput.value = variant.id;
          if (variant.featured_image && imageEl) {
            imageEl.src = variant.featured_image.src;
          }
        }

        if (!allChosen) {
          submitBtn.disabled = true;
          submitText.textContent = 'SELECT OPTIONS';
        } else if (!variant || !variant.available) {
          submitBtn.disabled = true;
          submitText.textContent = 'SOLD OUT';
        } else {
          submitBtn.disabled = false;
          submitText.textContent = 'ADD TO CART';
        }
      }

      function formatMoney(cents) {
        // Swap for `Shopify.formatMoney` if you load moneyFormat from settings.
        return '$' + (cents / 100).toFixed(2);
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        submitBtn.disabled = true;

        var variantId = idInput.value;
        var selected = getSelectedOptions();
        var variant = findVariant(product, selected);

        var items = [{ id: variantId, quantity: 1 }];

        // Cross-sell rule: any product added with Black + Medium options
        // also adds the Soft Winter Jacket, configured via
        // data-cross-sell-variant-id on the panel.
        var crossSellId = panel.getAttribute('data-cross-sell-variant-id');
        if (variant && crossSellId && hasBlackAndMedium(variant)) {
          items.push({ id: crossSellId, quantity: 1 });
        }

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items })
        })
          .then(function (response) {
            if (!response.ok) throw new Error('Add to cart failed');
            return response.json();
          })
          .then(function () {
            statusEl.removeAttribute('data-status');
            statusEl.textContent = 'Added to cart';
            document.dispatchEvent(new CustomEvent('ec:cart-updated'));
            submitBtn.disabled = false;
          })
          .catch(function () {
            statusEl.setAttribute('data-status', 'error');
            statusEl.textContent = 'Something went wrong. Please try again.';
            submitBtn.disabled = false;
          });
      });

      function hasBlackAndMedium(variant) {
        var values = variant.options.map(function (value) {
          return (value || '').toLowerCase();
        });
        return values.indexOf('black') > -1 && values.indexOf('medium') > -1;
      }
    }

    function openPanel(panel) {
      panel.hidden = false;
      document.body.style.overflow = 'hidden';
      var closeBtn = panel.querySelector('[data-quick-view-close]');
      if (closeBtn) closeBtn.focus();
    }

    function closePanel(panel) {
      panel.hidden = true;
      document.body.style.overflow = '';
    }
  }
</script>